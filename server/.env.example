# Copy this file to .env and fill in real values.
# Never commit the real .env — it's already gitignored.

# ── Server ──────────────────────────────────────────────────────────────────

# Port the API listens on. Most hosts (Render included) inject their own PORT
# at runtime and ignore this — safe to leave as-is.
PORT=4000

# development | production | test
# Must be exactly "production" on a real deployment — this also switches on a
# startup check that refuses to boot with the default JWT_SECRET below.
NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────

# PostgreSQL connection string, used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# On Render: use the "Internal Database URL" if the API and database are in
# the same region (faster, free egress); use the "External Database URL"
# only if connecting from outside Render, and add ?sslmode=require to it.
DATABASE_URL=postgresql://user:password@localhost:5432/fixflow

# ── Auth ─────────────────────────────────────────────────────────────────────

# Secret used to sign login tokens. MUST be a long, random, private value in
# production — the server will refuse to start in production with the
# placeholder below. Generate one with: openssl rand -base64 48
JWT_SECRET=dev-secret-change-in-production

# How long a login session lasts before the user has to log in again.
JWT_EXPIRES_IN=12h

# ── CORS ─────────────────────────────────────────────────────────────────────

# The exact origin (scheme + host, no trailing slash) of the deployed
# frontend. The API only accepts requests from this one origin — get this
# wrong and every request from the real frontend will fail with a CORS error,
# not an auth error, which can be confusing to debug.
FRONTEND_URL=http://localhost:3000
