# Copy this file to .env.local and fill in real values.
# Never commit the real .env.local — it's already gitignored.

# Base URL of the FixFlow API, including the /api prefix.
# Local dev (matches server/.env.example's default PORT):
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Production example (Render):
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api
#
# This is a NEXT_PUBLIC_ variable, which means it's baked into the JavaScript
# bundle at build time and visible to anyone in the browser — that's expected
# and fine (it's just the API's public address), but it also means changing
# it requires a new build/deploy, not just an env var update on a running
# instance.
